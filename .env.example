# Names and placeholders only — never commit real values.
# Runtime values are supplied by Lovable Cloud / project secrets.

# --- Client-visible (safe, publishable) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Absolute production origin, no trailing slash (e.g. https://example.com)
VITE_SITE_URL=
# "true" only at launch; anything else keeps the site noindex + Disallow: /
VITE_SITE_INDEXABLE=

